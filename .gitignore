# ---------------------------------------------------------------------------
# macOS
# ---------------------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*

# Files that might appear in the root of a volume
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Directories potentially created on remote AFP share
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

# ---------------------------------------------------------------------------
# Editors and IDEs
# ---------------------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*~
*.sublime-workspace

# Claude Code config (local preview server, settings): not part of the app
.claude/

# ---------------------------------------------------------------------------
# Static web project tooling (no build step today, but common add-ons)
# ---------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/
.cache/
dist/
build/
.lighthouseci/

# Local servers / Python helpers
__pycache__/
*.py[cod]

# Hosting CLIs (Cloudflare Pages, Netlify, Vercel, Firebase)
.wrangler/
.dev.vars
.netlify/
.vercel/
.firebase/
*.log

# Environment files and secrets
.env
.env.*
!.env.example

# ---------------------------------------------------------------------------
# Project-specific
# ---------------------------------------------------------------------------
# Rulebook PDFs and other copyrighted source material: never commit these.
*.pdf

# Rule data with official wording kept outside the public repo
# (e.g. data/bolt-action.private.json). See README "About the rules text".
data/*.private.json

# Scratch files
*.tmp
*.bak
